# ============================================================================
# ZK-SONG — production build variables (frontend)
#
# Only used at build time by Vite. Backend secrets live in /etc/zksong.env on a
# VPS or in the host's environment-variable dashboard on Vercel/Netlify.
# ============================================================================

# Leave EMPTY when the same Node server serves both the website and the API
# (VPS, Docker, Render, Fly) — the frontend then uses same-origin URLs.
VITE_API_BASE_URL=

# Set this only when the website is hosted separately from the API (shape D):
# VITE_API_BASE_URL=https://api.your-domain.com
