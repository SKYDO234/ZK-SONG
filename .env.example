# ============================================================================
# ZK-SONG — environment variables
#
# Copy to .env for local use (npm run dev reads it) or set the same keys in your
# host's dashboard. Every variable is optional except ADMIN_EMAIL/ADMIN_PASSWORD
# and JWT_SECRET, which you should always set in production.
# ============================================================================

# ------------------------------------------------------------------ server
PORT=4000
NODE_ENV=development

# Long random string — sessions are signed with it.
#   openssl rand -hex 32
JWT_SECRET=a23b6e24918e8ce7d4fdc74354130a0dae377af75d6bfea6b61bb88f7227d80c

# Comma-separated origins allowed to call the API from a browser.
# Leave empty to allow any origin (fine for local development).
# ALLOWED_ORIGIN=https://your-domain.com,https://your-site.vercel.app

# ------------------------------------------------------------------- admin
# The ONLY account that can ever hold the admin role.
# Created on first boot; changing the password here later does not change it in
# the database (use Forgot Password or the account panel).
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ZkSong2026!Admin
ADMIN_NAME=Platform Administrator

# ============================================================================
# Storage & database
#
# Leave BOTH sections below empty for a self-hosted server (your VPS, Docker,
# Render, Fly): SQLite + local disk are used and everything works out of the box.
# ============================================================================

# ------------------------------------------------------- self-hosted (VPS)
# Where the SQLite database lives — keep it off the git checkout.
# DATA_DIR=./server/data
# Where uploaded audio/covers/videos are stored.
# UPLOADS_DIR=./server/uploads
# Per-file upload limit in MB.
MAX_UPLOAD_MB=120

# ------------------------------------------- serverless (Vercel / Netlify)
# Set DATABASE_URL and the two Supabase keys and the API switches to
# Postgres + object storage automatically. Run supabase/schema.sql first.
#
# IMPORTANT — use the SESSION POOLER host (Supabase -> Connect -> Session pooler):
#   postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
# On the Free plan the direct host (db.<ref>.supabase.co) is IPv6-only and cannot
# be reached from Vercel. The username is postgres.<project-ref>, and 5432 keeps
# session mode so advisory locks (used by the admin bootstrap) work.
# DATABASE_URL=postgresql://postgres.whfbyzeisfhzlezyqjmu:ZkSong2026StudioPlatform@aws-N-ap-south-1.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://whfbyzeisfhzlezyqjmu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndoZmJ5emVpc2Zoemxlenlxam11Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5NDU1OTAwMCwiZXhwIjoyMTEwMTM1MDAwfQ.H0rQCNtr0qz3WKgtSeP-KEpPvrzDJ-vBxlUAayThqbE
# SUPABASE_BUCKET=media

# ============================================================================
# Frontend
# ============================================================================

# Only needed when the website is hosted apart from the API (shape D).
# Empty = same origin (Express serves both).
# VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=
