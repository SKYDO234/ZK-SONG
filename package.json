{
  "name": "zk-song-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ZK-SONG - Modern Professional Music Uploading, Administration & Streaming API Platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --no-warnings server/index.js",
    "client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production node --no-warnings server/index.js",
    "smoke": "node scripts/dom-smoke.cjs",
    "smoke:build": "npx esbuild src/main.jsx --bundle --format=iife --loader:.jsx=jsx --loader:.css=empty --define:process.env.NODE_ENV='\"production\"' --outfile=/tmp/client.js --log-level=error",
    "smoke:ui": "node scripts/ui-interactions.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "xmlhttprequest": "^1.8.0"
  }
}
